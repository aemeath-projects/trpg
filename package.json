{
  "name": "@aemeath-projects/trpg",
  "version": "1.0.2",
  "description": "TRPG 骰娘规则引擎：无状态掷骰求值、CoC/D&D 规则判定、人物生成公式、日志状态机等纯函数集合",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" --fix",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bump": "commit-and-tag-version",
    "bump:patch": "commit-and-tag-version --release-as patch",
    "bump:minor": "commit-and-tag-version --release-as minor",
    "bump:major": "commit-and-tag-version --release-as major",
    "changelog": "commit-and-tag-version --skip.bump --skip.commit --skip.tag",
    "commit": "cz",
    "prepare": "husky"
  },
  "keywords": [
    "trpg",
    "dice-roller",
    "coc",
    "dnd",
    "rule-engine",
    "typescript"
  ],
  "author": "Aemeath Projects",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aemeath-projects/trpg.git"
  },
  "bugs": {
    "url": "https://github.com/aemeath-projects/trpg/issues"
  },
  "homepage": "https://aemeath.dev",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./dice": {
      "types": "./dist/dice/index.d.ts",
      "import": "./dist/dice/index.js"
    },
    "./coc": {
      "types": "./dist/coc/index.d.ts",
      "import": "./dist/coc/index.js"
    },
    "./dnd": {
      "types": "./dist/dnd/index.d.ts",
      "import": "./dist/dnd/index.js"
    },
    "./decks": {
      "types": "./dist/decks/index.d.ts",
      "import": "./dist/decks/index.js"
    },
    "./stats": {
      "types": "./dist/stats/index.d.ts",
      "import": "./dist/stats/index.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "import": "./dist/log/index.js"
    },
    "./story": {
      "types": "./dist/story/index.d.ts",
      "import": "./dist/story/index.js"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "commit-and-tag-version": "^13.1.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "msgpackr": "^2.0.5"
  }
}
